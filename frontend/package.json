{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "serve": "vite --port 9051 --host",
    "lint": "eslint . --fix --ignore-pattern .gitignore",
    "lint:tsc": "vue-tsc",
    "build:prod": "vite build --mode production",
    "openapi:gen": "openapi --input ../resources/openapi.yaml --output ./src/models/api --client fetch",
    "fmt": "prettier . --write",
    "check": "prettier . --check",
    "test": "vitest run",
    "test:unit": "vitest && vue-tsc"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "apexcharts": "^7.6.0",
    "core-js": "^3.50.0",
    "echarts": "^6.1.0",
    "moment": "^2.31.0",
    "pinia": "^4.0.3",
    "roboto-fontface": "^0.10.0",
    "ts-json-schema-generator": "^2.9.0",
    "vue": "^3.5.43",
    "vue-codemirror6": "^1.7.0",
    "vue-echarts": "^8.3.0",
    "vue-router": "^5.3.1",
    "vue3-apexcharts": "^1.11.1",
    "vuetify": "^4.2.2"
  },
  "devDependencies": {
    "@babel/types": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/d3": "^7.4.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "msw": "^2.15.0",
    "openapi-typescript-codegen": "^0.31.0",
    "prettier": "3.9.9",
    "sass": "^1.105.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "~5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.1.2"
}
