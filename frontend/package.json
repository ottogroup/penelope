{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "serve": "vite --port 9051 --host",
    "lint": "eslint . --fix --ignore-pattern .gitignore",
    "lint:tsc": "vue-tsc",
    "build:prod": "vite build --mode production",
    "openapi:gen": "openapi --input ../resources/openapi.yaml --output ./src/models/api --client fetch",
    "fmt": "prettier . --write",
    "check": "prettier . --check",
    "test": "vitest run",
    "test:unit": "vitest && vue-tsc"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "apexcharts": "^5.16.0",
    "core-js": "^3.51.0",
    "echarts": "^6.1.0",
    "moment": "^2.31.0",
    "pinia": "^3.0.4",
    "roboto-fontface": "^0.10.0",
    "ts-json-schema-generator": "^2.9.0",
    "vue": "^3.5.45",
    "vue-codemirror6": "^1.7.0",
    "vue-echarts": "^8.3.2",
    "vue-router": "^4.6.4",
    "vue3-apexcharts": "^1.11.3",
    "vuetify": "^3.13.7"
  },
  "devDependencies": {
    "@babel/types": "^7.29.11",
    "@eslint/js": "^9.39.5",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/d3": "^7.4.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "msw": "^2.15.0",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "3.6.2",
    "sass": "^1.108.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "~3.2.7",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@11.1.2"
}
