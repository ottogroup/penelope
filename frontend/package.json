{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "serve": "vite --port 9051 --host",
    "lint": "eslint . --fix --ignore-pattern .gitignore",
    "lint:tsc": "vue-tsc",
    "build:prod": "vite build --mode production",
    "openapi:gen": "openapi --input ../resources/openapi.yaml --output ./src/models/api --client fetch",
    "fmt": "prettier . --write",
    "check": "prettier . --check",
    "test": "vitest run",
    "test:unit": "vitest && vue-tsc"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.8",
    "@mdi/font": "^7.4.47",
    "apexcharts": "^5.5.0",
    "core-js": "^3.45.1",
    "echarts": "^6.0.0",
    "moment": "^2.30.1",
    "pinia": "^3.0.3",
    "roboto-fontface": "*",
    "ts-json-schema-generator": "^2.5.0",
    "vue": "^3.5.28",
    "vue-codemirror6": "^1.4.2",
    "vue-echarts": "^8.0.0",
    "vue-router": "^5.0.2",
    "vue3-apexcharts": "^1.4.4",
    "vuetify": "^3.11.8"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/d3": "^7.4.3",
    "@types/markdown-it": "^14.1.1",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/compiler-sfc": "^3.5.22",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.3.0",
    "msw": "^2.12.10",
    "openapi-typescript-codegen": "^0.30.0",
    "prettier": "3.8.1",
    "sass": "^1.93.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.1.9",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "~4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "yarn@1.22.22"
}
